# Copy to .env (git-ignored). nimlab reads NVIDIA_*, NIM_* and NIMLAB_* keys from ./.env
# (existing environment variables win). Without NVIDIA_API_KEY everything runs on the offline
# deterministic mock backend.

# Get a key at https://build.nvidia.com (nvapi-...)
NVIDIA_API_KEY=

# --- optional -------------------------------------------------------------------------------
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NIM_RERANK_URL=https://ai.api.nvidia.com/v1/retrieval
# NIM_TIMEOUT=120
# NIM_MAX_RETRIES=5
# NIM_MAX_CONCURRENCY=8

# Force the offline mock backend even when a key is set (1) / force real calls without a key (0)
# NIMLAB_MOCK=1
# Artificial per-call latency (seconds) for the mock backend, handy for demos
# NIMLAB_MOCK_LATENCY=0.2

# Per-role model overrides (see `nimlab models`): NIMLAB_MODEL_<ROLE>
# roles: CHAT REASONING CODER VISION EMBED RERANK REWARD SAFETY FAST
# NIMLAB_MODEL_CODER=qwen/qwen2.5-coder-32b-instruct
# NIMLAB_MODEL_CHAT=meta/llama-3.3-70b-instruct

# Log level for the "nimlab" logger (DEBUG, INFO, WARNING)
# NIMLAB_LOG_LEVEL=WARNING
