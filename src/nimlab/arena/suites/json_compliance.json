{
  "name": "json_compliance",
  "title": "JSON compliance",
  "description": "Structured-output prompts; the reply must contain JSON that validates against the item's JSON Schema.",
  "category": "json_compliance",
  "version": "1",
  "system": "You are a data-extraction API. Output valid JSON only.",
  "temperature": 0.0,
  "max_tokens": 500,
  "items": [
    {
      "id": "person-extract",
      "prompt": "Extract the person from this sentence into JSON with keys name (string), age (integer) and city (string): \"Maria Lopez, who just turned 34, moved to Lisbon last spring.\"\n\nRespond with a single JSON value and nothing else.",
      "grader": {
        "type": "json_schema",
        "schema": {
          "type": "object",
          "required": [
            "name",
            "age",
            "city"
          ],
          "properties": {
            "name": {
              "const": "Maria Lopez"
            },
            "age": {
              "const": 34
            },
            "city": {
              "const": "Lisbon"
            }
          }
        }
      },
      "reference": "{\"name\": \"Maria Lopez\", \"age\": 34, \"city\": \"Lisbon\"}"
    },
    {
      "id": "product-listing",
      "prompt": "Create a product listing as a JSON object for a ceramic mug priced at 12.50 dollars that is currently in stock, with tags 'kitchen' and 'gift'. Keys: title (string), price (number greater than 0), in_stock (boolean), tags (array of strings, at least 2).\n\nRespond with a single JSON value and nothing else.",
      "grader": {
        "type": "json_schema",
        "schema": {
          "type": "object",
          "required": [
            "title",
            "price",
            "in_stock",
            "tags"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "price": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "in_stock": {
              "const": true
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 2
            }
          }
        }
      },
      "reference": "{\"title\": \"Ceramic mug\", \"price\": 12.5, \"in_stock\": true, \"tags\": [\"kitchen\", \"gift\"]}"
    },
    {
      "id": "recipe-ingredients",
      "prompt": "Convert this recipe to JSON: \"Pancakes for 4 people: 200 g flour, 2 eggs, 300 ml milk.\" Use keys title (string), servings (integer) and ingredients (array of objects with name (string), quantity (number) and unit (string)). Use 'piece' as the unit for eggs.\n\nRespond with a single JSON value and nothing else.",
      "grader": {
        "type": "json_schema",
        "schema": {
          "type": "object",
          "required": [
            "title",
            "servings",
            "ingredients"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "servings": {
              "const": 4
            },
            "ingredients": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "quantity",
                  "unit"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "quantity": {
                    "type": "number"
                  },
                  "unit": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "reference": "{\"title\": \"Pancakes\", \"servings\": 4, \"ingredients\": [{\"name\": \"flour\", \"quantity\": 200, \"unit\": \"g\"}, {\"name\": \"eggs\", \"quantity\": 2, \"unit\": \"piece\"}, {\"name\": \"milk\", \"quantity\": 300, \"unit\": \"ml\"}]}"
    },
    {
      "id": "sentiment",
      "prompt": "Classify the sentiment of this review: \"The battery died after two days and support never answered.\" Return an object with sentiment (one of 'positive', 'negative', 'neutral') and confidence (a number between 0 and 1).\n\nRespond with a single JSON value and nothing else.",
      "grader": {
        "type": "json_schema",
        "schema": {
          "type": "object",
          "required": [
            "sentiment",
            "confidence"
          ],
          "additionalProperties": false,
          "properties": {
            "sentiment": {
              "const": "negative"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      },
      "reference": "{\"sentiment\": \"negative\", \"confidence\": 0.95}"
    },
    {
      "id": "meeting-notes",
      "prompt": "From these notes build JSON: \"Attendees: Priya, Tom and Jin. Priya will send the budget by 2025-03-14. Tom will book the venue by 2025-03-20.\" Keys: attendees (array of strings, at least 2) and action_items (array of objects with owner (string), task (string) and due (string formatted YYYY-MM-DD)).\n\nRespond with a single JSON value and nothing else.",
      "grader": {
        "type": "json_schema",
        "schema": {
          "type": "object",
          "required": [
            "attendees",
            "action_items"
          ],
          "properties": {
            "attendees": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 2
            },
            "action_items": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": [
                  "owner",
                  "task",
                  "due"
                ],
                "properties": {
                  "owner": {
                    "type": "string"
                  },
                  "task": {
                    "type": "string"
                  },
                  "due": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  }
                }
              }
            }
          }
        }
      },
      "reference": "{\"attendees\": [\"Priya\", \"Tom\", \"Jin\"], \"action_items\": [{\"owner\": \"Priya\", \"task\": \"send the budget\", \"due\": \"2025-03-14\"}, {\"owner\": \"Tom\", \"task\": \"book the venue\", \"due\": \"2025-03-20\"}]}"
    },
    {
      "id": "flight-booking",
      "prompt": "Encode this booking as JSON: two passengers flying from Boston (BOS) to Denver (DEN) on 2025-06-02. Keys: flight (object with from, to as 3-letter uppercase IATA codes, and departure as YYYY-MM-DD string) and passengers (integer, at least 1).\n\nRespond with a single JSON value and nothing else.",
      "grader": {
        "type": "json_schema",
        "schema": {
          "type": "object",
          "required": [
            "flight",
            "passengers"
          ],
          "properties": {
            "flight": {
              "type": "object",
              "required": [
                "from",
                "to",
                "departure"
              ],
              "properties": {
                "from": {
                  "const": "BOS"
                },
                "to": {
                  "const": "DEN"
                },
                "departure": {
                  "type": "string",
                  "pattern": "^2025-06-02$"
                }
              }
            },
            "passengers": {
              "const": 2
            }
          }
        }
      },
      "reference": "{\"flight\": {\"from\": \"BOS\", \"to\": \"DEN\", \"departure\": \"2025-06-02\"}, \"passengers\": 2}"
    },
    {
      "id": "top-three",
      "prompt": "Return a JSON array of exactly 3 objects, each with rank (integer, 1 to 3) and title (string), listing three classic science-fiction novels in any order of your choice, ranked 1 to 3.\n\nRespond with a single JSON value and nothing else.",
      "grader": {
        "type": "json_schema",
        "schema": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "rank",
              "title"
            ],
            "properties": {
              "rank": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "title": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "reference": "[{\"rank\": 1, \"title\": \"Dune\"}, {\"rank\": 2, \"title\": \"Neuromancer\"}, {\"rank\": 3, \"title\": \"Foundation\"}]"
    },
    {
      "id": "event-nullable",
      "prompt": "Describe an online webinar called 'Intro to Rust' on 2025-09-10 as JSON with keys title (string), date (string, YYYY-MM-DD) and location (string or null; use null because it is online).\n\nRespond with a single JSON value and nothing else.",
      "grader": {
        "type": "json_schema",
        "schema": {
          "type": "object",
          "required": [
            "title",
            "date",
            "location"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "date": {
              "const": "2025-09-10"
            },
            "location": {
              "type": "null"
            }
          }
        }
      },
      "reference": "{\"title\": \"Intro to Rust\", \"date\": \"2025-09-10\", \"location\": null}"
    },
    {
      "id": "config-strict",
      "prompt": "Produce a configuration object with exactly these keys and no others: mode (one of 'fast', 'safe', 'debug'; choose 'safe'), retries (integer from 0 to 5; choose 3) and verbose (boolean; choose false).\n\nRespond with a single JSON value and nothing else.",
      "grader": {
        "type": "json_schema",
        "schema": {
          "type": "object",
          "required": [
            "mode",
            "retries",
            "verbose"
          ],
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "safe"
            },
            "retries": {
              "const": 3
            },
            "verbose": {
              "const": false
            }
          }
        },
        "strict": true
      },
      "reference": "{\"mode\": \"safe\", \"retries\": 3, \"verbose\": false}"
    },
    {
      "id": "dates-list",
      "prompt": "Extract every date from this text as an array of ISO strings under the key dates: \"Kickoff is 2025-01-15, the review follows on 2025-02-03 and launch is set for 2025-04-30.\" Return an object like {\"dates\": [...]}.\n\nRespond with a single JSON value and nothing else.",
      "grader": {
        "type": "json_schema",
        "schema": {
          "type": "object",
          "required": [
            "dates"
          ],
          "additionalProperties": false,
          "properties": {
            "dates": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "string",
                "format": "date"
              },
              "prefixItems": [
                {
                  "const": "2025-01-15"
                },
                {
                  "const": "2025-02-03"
                },
                {
                  "const": "2025-04-30"
                }
              ]
            }
          }
        },
        "strict": true
      },
      "reference": "{\"dates\": [\"2025-01-15\", \"2025-02-03\", \"2025-04-30\"]}"
    }
  ]
}
