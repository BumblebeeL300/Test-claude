{
  "name": "qa_from_docs",
  "kind": "qa_from_docs",
  "description": "Grounded question-answer pairs written from your own documents (markdown, text, HTML, PDF). Answers must stay close to the source excerpt.",
  "seed_role": "chat",
  "generator_role": "chat",
  "temperatures": [0.3, 0.6, 0.9],
  "max_tokens": 500,
  "chunk_chars": 900,
  "chunk_overlap": 100,
  "default_format": "openai-chat",
  "filters": {"min_reward": -8.0, "min_judge": 6.0, "min_chars": 30, "max_chars": 3000, "min_grounding": 0.5},
  "dedup": {"exact": true, "near": true, "threshold": 0.9, "field": "prompt"},
  "decontaminate": {"enabled": true, "ngram": 8, "min_overlap": 0.5, "check": "prompt"}
}
